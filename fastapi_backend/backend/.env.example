# FastAPI Backend Environment

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,*

# Storage configuration
STORAGE_PROVIDER=onedrive  # options: onedrive, local
LOCAL_STORAGE_PATH=./data/sessions

# OneDrive integration (Microsoft Graph)
# Obtain OAuth confidential client credentials and a drive/folder to store notes.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=
ONEDRIVE_DRIVE_ID=         # Optional: Specific drive id, otherwise default
ONEDRIVE_FOLDER_ID=        # Target folder id for session notes
ONEDRIVE_AUTHORITY=https://login.microsoftonline.com
ONEDRIVE_SCOPE=https://graph.microsoft.com/.default

# RAG / Vector DB
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=basic # placeholder; custom basic embedding

# General
APP_ENV=development

# Site URL for email redirects if any auth integration is added later
SITE_URL=http://localhost:3000
