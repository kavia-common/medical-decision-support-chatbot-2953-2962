# Backend runtime configuration

# Uvicorn host/port (defaults set for Kavia cloud preview)
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=3000

# Comma-separated list of allowed origins for CORS.
# When set, these are merged with the default Kavia preview origin.
# Example:
# CORS_ALLOWED_ORIGINS=https://example.com,https://my-frontend.app
# CORS_ALLOWED_ORIGINS=

# Storage configuration
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/sessions

# Optional OneDrive configuration (only needed if using OneDrive provider)
# ONEDRIVE_CLIENT_ID=
# ONEDRIVE_CLIENT_SECRET=
# ONEDRIVE_TENANT_ID=
# ONEDRIVE_DRIVE_ID=
# ONEDRIVE_FOLDER_ID=
# ONEDRIVE_AUTHORITY=https://login.microsoftonline.com
# ONEDRIVE_SCOPE=https://graph.microsoft.com/.default

# Vector store configuration
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=basic

# Site URL (used for redirects if needed)
SITE_URL=http://localhost:3000
